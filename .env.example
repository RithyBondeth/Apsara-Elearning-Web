# Copy to .env.local and fill in for your environment.

# Base URL of the api-gateway, including its global prefix.
# Matches API_GATEWAY_PORT in apsara-elearning-api/.env.example.
NEXT_PUBLIC_API_URL=http://localhost:1111/api/v1/internal

# Base URL of the admin-gateway, including its global prefix.
# Matches ADMIN_GATEWAY_PORT in apsara-elearning-api/.env.example.
# Server-only on purpose — the admin gateway is never addressed from the
# browser, which reaches it through /api/admin/* on this origin instead.
# Without this, /admin loads but every request returns 500.
ADMIN_API_URL=http://localhost:2222/admin

# Exact public web origin used for CSRF validation in production.
APP_ORIGIN=http://localhost:3000

# Public inbox used by the Contact page's prepared email workflow.
NEXT_PUBLIC_SUPPORT_EMAIL=support@apsaraelearning.com

# Shared secret with the api-gateway (same value as its INTERNAL_PROXY_SECRET).
# Server-only. Lets the gateway rate-limit by the real browser IP instead of
# treating every proxied call as coming from this server. Min 32 chars.
INTERNAL_PROXY_SECRET=
